{
  "name": "bukti-workspace",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "bukti", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID", "migrations_dir": "drizzle" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
